    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-03-25T05:47:25.331414Z\",\n",
    "     \"start_time\": \"2025-03-25T05:39:12.094585Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.model_selection import GridSearchCV, RandomizedSearchCV\\n\",\n",
    "    \"from scipy.stats import randint as sp_randint\\n\",\n",
    "    \"import joblib\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define the parameter grid for GridSearchCV\\n\",\n",
    "    \"param_grid = {\\n\",\n",
    "    \"    'tfidf__max_df': [0.7, 0.8, 0.9, 1.0],\\n\",\n",
    "    \"    'tfidf__min_df': [1, 2, 5],\\n\",\n",
    "    \"    'tfidf__ngram_range': [(1, 1), (1, 2)],\\n\",\n",
    "    \"    'rf__n_estimators': [100, 200],\\n\",\n",
    "    \"    'rf__max_depth': [None, 10, 20],\\n\",\n",
    "    \"    'rf__min_samples_split': [2, 5]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set up GridSearchCV\\n\",\n",
    "    \"grid_search = GridSearchCV(\\n\",\n",
    "    \"    pipeline,          # our previously defined pipeline\\n\",\n",
    "    \"    param_grid,        # hyperparameters to tune\\n\",\n",
    "    \"    cv=5,              # 5-fold cross-validation\\n\",\n",
    "    \"    n_jobs=-1,         # use all available cores\\n\",\n",
    "    \"    verbose=1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Fit GridSearchCV to the training data\\n\",\n",
    "    \"grid_search.fit(X_train, y_train)\\n\",\n",
    "    \"print(\\\"Best parameters from GridSearchCV:\\\", grid_search.best_params_)\\n\",\n",
    "    \"print(\\\"Best cross-validation score (GridSearchCV):\\\", grid_search.best_score_)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define parameter distributions for RandomizedSearchCV\\n\",\n",
    "    \"param_dist = {\\n\",\n",
    "    \"    'tfidf__max_df': [0.7, 0.8, 0.9, 1.0],\\n\",\n",
    "    \"    'tfidf__min_df': sp_randint(1, 10),\\n\",\n",
    "    \"    'tfidf__ngram_range': [(1, 1), (1, 2)],\\n\",\n",
    "    \"    'rf__n_estimators': sp_randint(100, 500),\\n\",\n",
    "    \"    'rf__max_depth': [None, 10, 20, 30],\\n\",\n",
    "    \"    'rf__min_samples_split': sp_randint(2, 11)\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set up RandomizedSearchCV\\n\",\n",
    "    \"random_search = RandomizedSearchCV(\\n\",\n",
    "    \"    pipeline,\\n\",\n",
    "    \"    param_distributions=param_dist,\\n\",\n",
    "    \"    n_iter=20,         # number of parameter settings sampled\\n\",\n",
    "    \"    cv=5,              # 5-fold cross-validation\\n\",\n",
    "    \"    n_jobs=-1,\\n\",\n",
    "    \"    verbose=1,\\n\",\n",
    "    \"    random_state=42\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Fit RandomizedSearchCV to the training data\\n\",\n",
    "    \"random_search.fit(X_train, y_train)\\n\",\n",
    "    \"print(\\\"Best parameters from RandomizedSearchCV:\\\", random_search.best_params_)\\n\",\n",
    "    \"print(\\\"Best cross-validation score (RandomizedSearchCV):\\\", random_search.best_score_)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Optionally, save the best model (from either search) for future use\\n\",\n",
    "    \"# For example, using the grid search best estimator:\\n\",\n",
    "    \"joblib.dump(grid_search.best_estimator_, 'random_forest_best_grid.pkl')\\n\",\n",
    "    \"# Or for the randomized search best estimator:\\n\",\n",
    "    \"joblib.dump(random_search.best_estimator_, 'random_forest_best_random.pkl')\\n\"\n",
    "   ],\n",
